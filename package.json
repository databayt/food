{
  "name": "food",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/fetch-thmanyah.mjs && tsx scripts/wake-db.ts",
    "dev": "next dev --turbopack -p 3000",
    "dev:kill": "lsof -ti:3000 | xargs kill -9 2>/dev/null; pnpm dev",
    "build": "node scripts/fetch-thmanyah.mjs && node scripts/maybe-migrate.mjs && prisma generate && pnpm i18n:check && next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "i18n:check": "tsx scripts/dev-i18n-sync.ts && tsx scripts/i18n-scan-hardcoded.ts",
    "i18n:sync": "tsx scripts/dev-i18n-sync.ts --fix",
    "i18n:scan": "tsx scripts/i18n-scan-hardcoded.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "wake-db": "tsx scripts/wake-db.ts",
    "seed": "tsx scripts/seed-menu.ts && tsx scripts/seed-admin.ts",
    "seed:menu": "tsx scripts/seed-menu.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:test-staff": "tsx scripts/seed-test-staff.ts",
    "postinstall": "prisma generate",
    "check:rate-limit": "tsx --conditions=react-server scripts/check-rate-limit.ts",
    "items:photos": "tsx scripts/process-item-photos.ts",
    "items:attach": "tsx scripts/set-item-photos.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@cloudflare/containers": "^0.3.7",
    "@formatjs/intl-localematcher": "^0.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.4",
    "lucide-react": "^1.48.0",
    "negotiator": "^1.1.0",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.31",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "ws": "^8.21.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@prisma/config": "^7.10.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "prisma": "^7.10.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "wrangler": "4.129.0"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
