// Orders. Every row below Order is an immutable order-time snapshot: menu
// edits never rewrite history. Totals are computed server-side only.

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  CASH
  MOMO
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

/// One push-to-pay request ("enter your PIN") sent to the payer's phone.
enum PaymentAttemptStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REJECTED
  TIMEOUT
}

model Customer {
  id          String   @id @default(cuid())
  phone       String   @unique // E.164, e.g. +250794000095
  name        String
  lastOrderAt DateTime @default(now())
  createdAt   DateTime @default(now())

  orders Order[]

  @@map("customers")
}

model Order {
  id             String          @id @default(cuid())
  /// Human-friendly number shown as "#1042". Sequence restarts at 1001.
  number         Int             @unique @default(autoincrement())
  /// Unguessable token for the guest tracking URL.
  publicToken    String          @unique
  /// Client-generated per checkout attempt; a retry returns the same order.
  idempotencyKey String          @unique
  status         OrderStatus     @default(NEW)
  fulfillment    FulfillmentType
  locale         String          @default("en")

  customerId       String
  customerName     String
  customerPhone    String
  deliveryAddress  String?
  /// Optional pin the guest shared at checkout (browser geolocation), so the
  /// rider can navigate where Kigali street addresses run out.
  deliveryLat      Float?
  deliveryLng      Float?
  /// Reported accuracy of the pin, in metres.
  deliveryAccuracy Int?
  note             String?

  subtotal    Int
  deliveryFee Int @default(0)
  total       Int

  confirmedAt  DateTime?
  preparingAt  DateTime?
  readyAt      DateTime?
  /// Delivery only: the rider left with the order (status stays READY).
  dispatchedAt DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payment  Payment?
  history  OrderStatusHistory[]

  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  menuItemId     String?
  /// Localized names at order time: { en, rw, ar }.
  names          Json
  unitPrice      Int
  quantity       Int
  modifiersTotal Int     @default(0)
  lineTotal      Int
  note           String?
  sortOrder      Int     @default(0)

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem  MenuItem?           @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id               String  @id @default(cuid())
  orderItemId      String
  modifierOptionId String?
  groupNames       Json
  optionNames      Json
  price            Int

  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String        @unique
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  amount       Int
  reference    String?
  /// Set when a provider confirmed the money (e.g. "MTN_MOMO"); null = cashier.
  provider     String?
  paidAt       DateTime?
  refundedAt   DateTime?
  recordedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedBy User?            @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  attempts   PaymentAttempt[]

  @@map("payments")
}

/// MTN MoMo Request to Pay. A declined or timed-out prompt keeps its row and
/// the guest can send a new one. Only a status read back from the provider
/// moves money state — callbacks are never trusted on their own.
model PaymentAttempt {
  id                     String               @id @default(cuid())
  paymentId              String
  provider               String               @default("MTN_MOMO")
  /// X-Reference-Id (UUID v4) we send to the provider.
  referenceId            String               @unique
  /// E.164, the number the prompt went to (may differ from the order phone).
  payerPhone             String
  amount                 Int
  status                 PaymentAttemptStatus @default(PENDING)
  /// The MoMo receipt number the payer sees in their SMS.
  financialTransactionId String?
  reason                 String?
  lastCheckedAt          DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([status, createdAt])
  @@map("payment_attempts")
}

/// Audit trail: one row per order-status change and per payment event.
model OrderStatusHistory {
  id        String       @id @default(cuid())
  orderId   String
  from      OrderStatus?
  to        OrderStatus?
  event     String       @default("STATUS") // STATUS | DISPATCHED | PAYMENT_PAID | PAYMENT_REFUNDED
  actorId   String?
  note      String?
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}
