# Charles Burgers — copy to .env (central env only; never .env.local / .env.x)

# Neon Postgres. Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_ADAPTER="neon"

# NextAuth (staff sign-in). Generate: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Extra origins allowed for server actions / the proxy origin check (comma-separated hosts)
ALLOWED_ORIGINS="localhost:3000"

# First admin — pnpm seed:admin
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Optional — Upstash rate limiting (falls back to Postgres counters)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional — S3 menu photo uploads (admin falls back to a pasted URL)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
NEXT_PUBLIC_CDN_DOMAIN=""

# Tests only
TEST_STAFF_PASSWORD="test-staff-password"
PLAYWRIGHT_BASE_URL=""

# MTN MoMo Collection — "Request to Pay" (PIN prompt on the guest's phone).
# Leave empty to keep the manual merchant-code flow.
# Sandbox: MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com, MOMO_TARGET_ENV=sandbox, MOMO_CURRENCY=EUR
# Rwanda live: MOMO_BASE_URL=https://proxy.momoapi.mtn.com, MOMO_TARGET_ENV=mtnrwanda, MOMO_CURRENCY=RWF
MOMO_BASE_URL=
MOMO_TARGET_ENV=
MOMO_CURRENCY=
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# https://bu.databayt.org/api/momo/callback — host must match the API user's callback host
MOMO_CALLBACK_URL=
